---
import DemoSurface from "@/components/ui-demo/DemoSurface.astro"
import Carousel from "@/components/common/Carousel"
---

<DemoSurface title="Carousel" description="Horizontal card track for featured content, compact showcases, and guided previews.">
  <Carousel client:load label="Demo cards" intervalMs={0}>
    {["First card", "Second card", "Third card"].map((title, index) => (
      <article
        class="flex min-h-56 snap-start flex-col rounded-lg border border-border/80 bg-background-0 p-5"
        data-carousel-item
      >
        <p class="font-mono text-xs tracking-[0.24em] text-foreground-3 uppercase">card {index + 1}</p>
        <h3 class="mt-4 font-display text-2xl text-foreground-0">{title}</h3>
        <p class="mt-3 text-sm leading-relaxed text-foreground-2">
          The carousel handles controls, snap behavior, and reduced motion support for you.
        </p>
      </article>
    ))}
  </Carousel>
</DemoSurface>
