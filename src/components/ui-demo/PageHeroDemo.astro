---
import DemoSurface from "@/components/ui-demo/DemoSurface.astro"
import PageHero from "@/components/common/PageHero.astro"
import { Badge } from "@/components/ui/badge"
---

<DemoSurface title="Page Hero" description="Four-sector shell for high-impact pages and section leaders.">
  <div class="-m-4 md:-m-5">
    <PageHero class="min-h-0" bottomRightClass="w-full">
      <Fragment slot="topLeft">
        <h2 class="font-display text-4xl leading-tight font-semibold tracking-tight text-foreground-0">
          Top-left content anchors the page.
        </h2>
      </Fragment>

      <Fragment slot="topRight">
        <Badge variant="outline">top right</Badge>
      </Fragment>

      <Fragment slot="bottomLeft">
        <p class="max-w-md text-base leading-relaxed text-foreground-1">
          Bottom-left content usually carries context, summary copy, or primary actions.
        </p>
      </Fragment>

      <Fragment slot="bottomRight">
        <div class="rounded-lg border border-border/80 bg-background-1 p-5">
          <p class="font-mono text-xs tracking-[0.24em] text-foreground-3 uppercase">bottom right</p>
          <p class="mt-3 text-sm leading-relaxed text-foreground-1">
            Use this area for stats, cards, previews, or any supporting block that balances the composition.
          </p>
        </div>
      </Fragment>
    </PageHero>
  </div>
</DemoSurface>
