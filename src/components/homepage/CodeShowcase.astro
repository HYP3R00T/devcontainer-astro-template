---
import Section from "@/components/common/Section.astro";

const componentExample = `---
import BaseLayout from "@/layouts/BaseLayout.astro"
import FeatureGrid from "@/components/FeatureGrid.astro"

const features = await getCollection("features")
---

<BaseLayout title="Build something useful">
  <FeatureGrid items={features} />
</BaseLayout>`;
---

<Section id="example" frameClass="grid lg:grid-cols-[minmax(18rem,0.4fr)_minmax(0,0.6fr)]">
  <div class="border-b border-border px-5 py-12 md:px-10 lg:border-r lg:border-b-0 lg:px-15 lg:py-16">
    <p class="font-mono text-xs tracking-[0.14em] text-accent-1 uppercase">Clear by default</p>
    <h2 class="mt-5 max-w-md font-display text-4xl font-medium tracking-[-0.035em] text-foreground-0 md:text-5xl">
      Code that explains itself.
    </h2>
    <p class="mt-6 max-w-md leading-7 text-foreground-2">
      Pages stay declarative. Content stays close to the product. Interactive pieces opt into JavaScript instead of
      making it the default.
    </p>

    <dl class="mt-12 grid grid-cols-2 gap-px border border-border bg-border">
      <div class="bg-background-0 p-4">
        <dt class="font-mono text-[0.6875rem] tracking-wider text-foreground-3 uppercase">Output</dt>
        <dd class="mt-2 text-sm font-medium text-foreground-0">Static-first</dd>
      </div>
      <div class="bg-background-0 p-4">
        <dt class="font-mono text-[0.6875rem] tracking-wider text-foreground-3 uppercase">JavaScript</dt>
        <dd class="mt-2 text-sm font-medium text-foreground-0">By component</dd>
      </div>
    </dl>
  </div>

  <div class="bg-background-1 p-3 md:p-6 lg:p-8">
    <div class="overflow-hidden border border-border bg-background-0">
      <div class="flex items-center justify-between border-b border-border px-4 py-3">
        <div class="flex items-center gap-2" aria-hidden="true">
          <span class="size-2 rounded-full bg-red-0"></span>
          <span class="size-2 rounded-full bg-yellow-0"></span>
          <span class="size-2 rounded-full bg-green-0"></span>
        </div>
        <span class="font-mono text-xs text-foreground-3">src/pages/index.astro</span>
      </div>
      <pre class="overflow-x-auto p-5 text-sm leading-7 text-foreground-1 md:p-8"><code>{componentExample}</code></pre>
    </div>
  </div>
</Section>
