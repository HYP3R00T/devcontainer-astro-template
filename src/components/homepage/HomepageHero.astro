---
import { Image } from "astro:assets";
import { Badge } from "@/components/ui/badge";
import { buttonVariants } from "@/components/ui/button";
import Carousel from "@/components/common/Carousel";
import PageHero from "@/components/common/PageHero.astro";
import { Icon } from "astro-icon/components";
import placeholder1 from "@/assets/placeholder1.png";
import placeholder2 from "@/assets/placeholder2.png";
import placeholder3 from "@/assets/placeholder3.png";
import placeholder4 from "@/assets/placeholder4.png";
import placeholder5 from "@/assets/placeholder5.png";
import { featuredProjects } from "@data/homepage";
import { SITE } from "@data/config";

const projectImages = [placeholder1, placeholder2, placeholder3, placeholder4, placeholder5] as const;
---

<PageHero id="hero" dataHomeSection bottomRightClass="w-full">
  <Fragment slot="topLeft">
    <h1
      class="font-display text-5xl leading-none font-semibold tracking-tighter text-foreground-0 sm:text-6xl lg:text-5xl xl:text-6xl"
    >
      A stronger Astro starter for content, components, and real project structure.
    </h1>
  </Fragment>

  <Fragment slot="topRight">
    <a href={SITE.repo} target="_blank" rel="noopener noreferrer" aria-label="Open the template repository">
      <Badge
        variant="outline"
        className="border-accent-1/70 bg-transparent px-2 font-mono text-[10px] font-medium tracking-widest text-accent-1 uppercase hover:border-accent-1 hover:text-accent-1"
      >
        Template source
      </Badge>
    </a>
  </Fragment>

  <Fragment slot="bottomLeft">
    <p class="font-mono text-xs tracking-widest text-foreground-2 uppercase">
      <span>Astro</span>
      <span class="text-foreground-3"> / </span>
      <span>Tailwind v4</span>
      <span class="text-foreground-3"> / </span>
      <span>Reusable shell</span>
    </p>
    <p class="mt-4 max-w-lg text-base leading-relaxed text-foreground-1 md:text-lg">
      This starter keeps the visual structure and component patterns from the reference project, while leaving the
      content intentionally generic so you can adapt it for docs, portfolios, products, or personal publishing.
    </p>
    <div class="mt-7 flex flex-col gap-3 sm:flex-row">
      <a href="/components" class={buttonVariants({ variant: "default", size: "lg" })}>
        Browse Components
        <Icon name="arrow-right" class="size-4" />
      </a>
      <a href={SITE.repo} target="_blank" rel="noopener noreferrer" class={buttonVariants({ variant: "outline", size: "lg" })}>
        View Repository
        <Icon name="arrow-up-right" class="size-4" />
      </a>
    </div>
  </Fragment>

  <Fragment slot="bottomRight">
    <Carousel client:load label="Starter paths" itemSelector="[data-project-card]">
      {
        featuredProjects.map((project, index) => (
          <a
            href={project.href}
            target={project.href.startsWith("http") ? "_blank" : undefined}
            rel={project.href.startsWith("http") ? "noopener noreferrer" : undefined}
            class="group flex h-full min-w-0 snap-start flex-col overflow-hidden rounded-lg border border-border/80 bg-background-1 p-3 transition-colors hover:bg-background-0"
            data-project-card
            data-carousel-item
          >
            <div class="aspect-video overflow-hidden rounded-md bg-background-1">
              <Image
                src={projectImages[index] ?? placeholder1}
                alt={`${project.title} preview`}
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                widths={[480, 720, 960]}
                sizes="(max-width: 1024px) 86vw, 420px"
              />
            </div>
            <div class="flex flex-1 flex-col px-1 pt-4 pb-1 xl:pt-5">
              <h2 class="font-display text-xl leading-tight text-foreground-0 xl:text-2xl">{project.title}</h2>
              <p class="mt-2 mb-6 text-sm leading-relaxed text-foreground-1">{project.body}</p>
              <div class="mt-auto pt-4 font-display text-sm font-medium text-foreground-1 transition-colors group-hover:text-accent-1">
                <span class="inline-flex items-center gap-2">
                  Explore path
                  <Icon name="arrow-up-right" class="size-4" />
                </span>
              </div>
            </div>
          </a>
        ))
      }
    </Carousel>
  </Fragment>
</PageHero>
