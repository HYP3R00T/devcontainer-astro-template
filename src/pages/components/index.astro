---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/common/PageHero.astro";
import CardGrid from "@/components/common/CardGrid.astro";
import { Badge } from "@/components/ui/badge";
import { Button } from "@/components/ui/button";
import { Icon } from "astro-icon/components";

const components = (await getCollection("components")).sort((a, b) => a.data.title.localeCompare(b.data.title));
const categories = [...new Set(components.map((component) => component.data.category).filter(Boolean))].sort();
const totalComponents = components.length;
---

<BaseLayout title="Components" description="A concise list of the custom components available in this project.">
  <PageHero id="components" class="pb-8 md:pb-12" bottomRightClass="w-full">
    <Fragment slot="topLeft">
      <h1 class="font-display text-5xl leading-none font-semibold tracking-tighter text-foreground-0 sm:text-6xl lg:text-5xl xl:text-6xl">
        Reference the UI components already living in this starter.
      </h1>
    </Fragment>

    <Fragment slot="topRight">
      <Badge variant="outline" className="border-accent-1/70 bg-transparent px-2 font-mono text-[10px] font-medium tracking-widest text-accent-1 uppercase">
        {totalComponents} documented components
      </Badge>
    </Fragment>

    <Fragment slot="bottomLeft">
      <p class="font-mono text-xs tracking-widest text-foreground-2 uppercase">
        <span>ui layer</span>
        <span class="text-foreground-3"> / </span>
        <span>documented directly from src/components/ui</span>
      </p>
      <p class="mt-4 max-w-lg text-base leading-relaxed text-foreground-1 md:text-lg">
        This index is intentionally scoped to the actual UI primitives in the `ui` folder. Demo files exist only to showcase those components cleanly inside the docs.
      </p>
    </Fragment>

    <Fragment slot="bottomRight">
      <div class="grid gap-4 sm:grid-cols-2">
        <article class="rounded-lg border border-border/80 bg-background-1 p-5">
          <p class="font-mono text-xs tracking-[0.24em] text-foreground-3 uppercase">Coverage</p>
          <p class="mt-4 font-display text-5xl leading-none font-semibold tracking-tighter text-foreground-0">
            {totalComponents}
          </p>
          <p class="mt-3 text-sm leading-relaxed text-foreground-1">Documented UI primitives currently included in this starter.</p>
        </article>

        <article class="rounded-lg border border-border/80 bg-background-1 p-5">
          <p class="font-mono text-xs tracking-[0.24em] text-foreground-3 uppercase">Categories</p>
          <div class="mt-4 flex flex-wrap gap-2">
            {categories.map((category) => <Badge variant="secondary">{category}</Badge>)}
          </div>
          <p class="mt-4 text-sm leading-relaxed text-foreground-1">Each entry maps directly to a component inside `src/components/ui`.</p>
        </article>
      </div>
    </Fragment>
  </PageHero>

  <section class="px-4 pt-10 pb-20 md:px-8 md:pt-16 md:pb-24 xl:pt-20">
    <div class="mx-auto w-full max-w-site">
      <div class="mb-10 max-w-2xl md:mb-14">
        <p class="font-mono text-xs tracking-[0.28em] text-accent-1 uppercase">Component Catalog</p>
        <h2 class="mt-4 font-display text-4xl leading-tight font-semibold tracking-tight text-foreground-0 md:text-5xl">
          Browse the documented UI primitives with a bit more room to breathe.
        </h2>
        <p class="mt-5 text-base leading-relaxed text-foreground-1 md:text-lg">
          The catalog should feel separated from the intro, not glued directly beneath it. These cards are meant to sit in their own section with clearer spacing and cleaner rhythm.
        </p>
      </div>

      <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-4">
        {
          components.map((component) => (
            <CardGrid class="h-full">
              <a
                href={`/components/${component.id}`}
                id={`component-${component.id}`}
                class="flex min-h-52 flex-col"
              >
                <div class="flex flex-1 flex-col gap-5">
                  <div>
                    <span
                      class="mt-4 block font-display text-2xl font-semibold text-foreground-1 group-hover:text-accent-1"
                      transition:name={`component-title-${component.id}`}
                    >
                      {component.data.title}
                    </span>
                    {
                      component.data.description && (
                        <p
                          class="mt-3 max-w-md text-sm leading-relaxed text-foreground-2"
                          transition:name={`component-description-${component.id}`}
                        >
                          {component.data.description}
                        </p>
                      )
                    }
                  </div>
                </div>

                <div class="mt-6">
                  <div class="flex justify-start">
                    <Button variant="outline" size="sm" className="gap-2">
                      View component
                      <Icon name="arrow-up-right" class="size-4" />
                    </Button>
                  </div>
                </div>
              </a>
            </CardGrid>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
